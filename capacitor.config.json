{
  "appId": "com.edenos.tinted",
  "appName": "Tinted",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#160b26"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#160b26",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    }
  }
}